{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd frontend && npx vite build",
    "watchPatterns": [
      "backend/**",
      "frontend/src/**",
      "frontend/index.html"
    ]
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "node backend/server.js",
    "healthcheckPath": "/api/akun",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
