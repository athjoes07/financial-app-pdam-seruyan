{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd frontend && npm install && npx vite build && cd ../backend && npm install"
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "node backend/server.js",
    "healthcheckPath": "/api/akun",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
